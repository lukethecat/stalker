{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel-agents.dev/spec/c3_skill.schema.json",
  "title": "C3 Skill Package Manifest",
  "description": "Agent Skills manifest + L0-L3 progressive disclosure + event subscription. Encodes the open/private boundary: a skill that contains attack payloads (ammo) must be private and require authorization.",
  "type": "object",
  "required": ["name", "version", "description", "visibility", "layers"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string", "minLength": 1, "description": "L0 one-line intent, always loaded." },
    "triggers": { "type": "array", "items": { "type": "string" } },
    "io_contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "input": { "type": "string" }, "output": { "type": "string" } }
    },
    "layers": {
      "type": "object",
      "description": "Progressive disclosure. L0 (intent) always required; L1 orchestration, L2 stage impl, L3 config loaded on demand.",
      "required": ["l0"],
      "additionalProperties": false,
      "properties": {
        "l0": { "type": "string", "minLength": 1 },
        "l1": { "type": "string" },
        "l2": { "type": "string" },
        "l3": { "type": "string" }
      }
    },
    "subscribes": { "type": "array", "items": { "type": "string", "pattern": "^(ingest|redteam)\\.[a-z].*" } },
    "emits": { "type": "array", "items": { "type": "string", "pattern": "^(ingest|redteam)\\.[a-z].*" } },
    "mount_points": {
      "type": "array",
      "items": { "enum": ["load_state", "save_state", "run_model", "register_cli_commands", "provide_tape_store", "provide_channels"] }
    },
    "visibility": { "enum": ["public", "private"] },
    "authorization_required": { "type": "boolean" },
    "contains_attack_payloads": { "type": "boolean", "description": "True for ammo (seeds / payloads / bypass prompts). Forces private + authorization_required." }
  },
  "allOf": [
    {
      "if": { "properties": { "contains_attack_payloads": { "const": true } }, "required": ["contains_attack_payloads"] },
      "then": {
        "required": ["visibility", "authorization_required"],
        "properties": {
          "visibility": { "const": "private" },
          "authorization_required": { "const": true }
        }
      }
    }
  ]
}
