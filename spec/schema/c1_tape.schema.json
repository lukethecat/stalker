{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel-agents.dev/spec/c1_tape.schema.json",
  "title": "C1 Tape Entry",
  "description": "One immutable, append-only record on a tape. A tape is JSONL: one entry per line. Corrections are appended via `supersedes`, never deleted.",
  "type": "object",
  "required": ["id", "schema_version", "ts", "kind", "actor"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1, "description": "Globally unique entry id (e.g. ULID/UUID)." },
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "SemVer of the entry schema; readers gate compatibility on the major component." },
    "ts": { "type": "string", "format": "date-time" },
    "kind": { "enum": ["event", "anchor", "message", "tool_call", "tool_result", "model_output", "note"] },
    "actor": { "$ref": "#/$defs/actor" },
    "supersedes": { "type": "string", "minLength": 1, "description": "Id of an earlier entry this corrects. Append-only: the superseded entry is never removed." },
    "reason": { "type": "string", "description": "Rationale captured alongside the fact (决策理由)." },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "anchor" } }, "required": ["kind"] },
      "then": { "required": ["payload"], "properties": { "payload": { "$ref": "#/$defs/anchor_payload" } } }
    },
    {
      "if": { "properties": { "kind": { "const": "event" } }, "required": ["kind"] },
      "then": { "required": ["payload"], "properties": { "payload": { "$ref": "#/$defs/event_payload" } } }
    }
  ],
  "$defs": {
    "actor": {
      "type": "object",
      "description": "Operator-equivalent actor: human / agent / system / timer are interchangeable operators.",
      "required": ["type", "id"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["human", "agent", "system", "timer"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "anchor_payload": {
      "type": "object",
      "description": "State contract carried at a phase boundary. Same shape is used for cold/hot migration (handoff).",
      "required": ["phase", "summary", "next_steps", "source_ids"],
      "properties": {
        "phase": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "next_steps": { "type": "array", "items": { "type": "string" } },
        "source_ids": { "type": "array", "items": { "type": "string" } },
        "state": { "type": "object" }
      }
    },
    "event_payload": {
      "type": "object",
      "description": "When kind==event the payload is a C2 domain event; full validation lives in c2_events.schema.json.",
      "required": ["name", "schema_version", "data"],
      "properties": {
        "name": { "type": "string", "pattern": "^(ingest|redteam)\\.[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
        "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "data": { "type": "object" }
      }
    }
  }
}
