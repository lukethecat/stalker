{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel-agents.dev/spec/c2_events.schema.json",
  "title": "C2 Domain Event",
  "description": "IPO domain event. Namespaced by domain: ingest.* (agent0) / redteam.* (agent1). An event is also a kind of C1 tape entry.",
  "type": "object",
  "required": ["name", "schema_version", "data"],
  "properties": {
    "name": { "type": "string", "pattern": "^(ingest|redteam)\\.[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "data": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "name": { "const": "redteam.target.registered" } }, "required": ["name"] },
      "then": { "properties": { "data": { "$ref": "#/$defs/target_registered" } } }
    },
    {
      "if": { "properties": { "name": { "const": "redteam.finding.logged" } }, "required": ["name"] },
      "then": { "properties": { "data": { "$ref": "#/$defs/finding_logged" } } }
    },
    {
      "if": { "properties": { "name": { "const": "redteam.metric.updated" } }, "required": ["name"] },
      "then": { "properties": { "data": { "$ref": "#/$defs/metric_updated" } } }
    }
  ],
  "$defs": {
    "target_registered": {
      "type": "object",
      "description": "Authorization gate: a target cannot be registered without explicit authorization. This invariant is enforced by schema.",
      "required": ["target_id", "authorization"],
      "properties": {
        "target_id": { "type": "string", "minLength": 1 },
        "authorization": {
          "type": "object",
          "required": ["authorized", "scope"],
          "properties": {
            "authorized": { "const": true },
            "scope": { "type": "string", "minLength": 1 },
            "authorized_by": { "type": "string" }
          }
        }
      }
    },
    "finding_logged": {
      "type": "object",
      "description": "A red-team finding must map to at least one standard taxonomy and carry reproduction + remediation.",
      "required": ["finding_id", "severity", "taxonomy", "reproduction", "remediation"],
      "properties": {
        "finding_id": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
        "taxonomy": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "owasp_llm": { "type": "array", "items": { "type": "string", "pattern": "^LLM\\d{2}$" } },
            "mitre_atlas": { "type": "array", "items": { "type": "string", "pattern": "^AML\\.[A-Za-z0-9.]+$" } },
            "nist_ai_rmf": { "type": "array", "items": { "type": "string" } }
          }
        },
        "reproduction": { "type": "string", "minLength": 1 },
        "remediation": { "type": "string", "minLength": 1 }
      }
    },
    "metric_updated": {
      "type": "object",
      "required": ["campaign_id", "metrics"],
      "properties": {
        "campaign_id": { "type": "string", "minLength": 1 },
        "metrics": {
          "type": "object",
          "properties": {
            "asr": { "type": "number", "minimum": 0, "maximum": 1 },
            "queries_per_attack": { "type": "number", "minimum": 0 },
            "total_queries": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
