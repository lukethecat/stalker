{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel-agents/spec/schema/c2_events.schema.json",
  "title": "C2 Event Taxonomy",
  "description": "IPO domain event envelope + payload contracts. Namespaces: `ingest.*` (agent0, event catalog open/extensible -- agent0's concrete events are not yet finalized, only its Collect/Structure/Judge/Publish IPO stages are) and `redteam.*` (agent1, event catalog closed to the 9 events enumerated in docs/architecture.md; extending it is a contract change requiring a schema version bump).",
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "run_id": { "type": "string", "minLength": 1 },
    "agent": { "type": "string", "minLength": 1 },

    "ingest_event_name": {
      "type": "string",
      "pattern": "^ingest\\.[a-z]+(\\.[a-z_]+)*$"
    },
    "redteam_event_name": {
      "type": "string",
      "enum": [
        "redteam.target.registered",
        "redteam.intel.ingested",
        "redteam.probe.built",
        "redteam.attack.round.completed",
        "redteam.strategy.adjusted",
        "redteam.finding.logged",
        "redteam.metric.updated",
        "redteam.report.ready",
        "redteam.remediation.retested"
      ]
    },

    "authorization": {
      "type": "object",
      "description": "Hard authorization gate. No redteam.* attack activity may start without this on the registered target.",
      "properties": {
        "scope": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "description": "Explicit list of what is in scope (e.g. endpoints, models, actions)."
        },
        "authorized_by": { "type": "string", "minLength": 1 },
        "authorized_at": { "$ref": "#/$defs/timestamp" },
        "expires_at": { "$ref": "#/$defs/timestamp" }
      },
      "required": ["scope", "authorized_by"],
      "additionalProperties": false
    },

    "payload_redteam.target.registered": {
      "type": "object",
      "properties": {
        "target": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "description": { "type": "string" }
          },
          "required": ["id"],
          "additionalProperties": true
        },
        "authorization": { "$ref": "#/$defs/authorization" }
      },
      "required": ["target", "authorization"],
      "additionalProperties": false
    },
    "payload_redteam.intel.ingested": {
      "type": "object",
      "properties": {
        "source_agent": { "type": "string", "const": "agent0" },
        "intel_ref": { "type": "string", "minLength": 1, "description": "Pointer to agent0 tape entry/entries or datapool id." },
        "summary": { "type": "string" }
      },
      "required": ["source_agent", "intel_ref"],
      "additionalProperties": false
    },
    "payload_redteam.probe.built": {
      "type": "object",
      "properties": {
        "probe_id": { "type": "string", "minLength": 1 },
        "target_ref": { "type": "string", "minLength": 1 },
        "method": {
          "type": "string",
          "enum": ["crescendo", "goat", "tap", "other"]
        },
        "expected_behavior": { "type": "string" },
        "rubric": { "type": "object" }
      },
      "required": ["probe_id", "target_ref", "method", "expected_behavior", "rubric"],
      "additionalProperties": false
    },
    "payload_redteam.attack.round.completed": {
      "type": "object",
      "properties": {
        "probe_ref": { "type": "string", "minLength": 1 },
        "round_index": { "type": "integer", "minimum": 0 },
        "attacker_output_ref": { "type": "string", "minLength": 1 },
        "judge_score": { "type": "number" },
        "verdict": { "type": "string", "enum": ["pass", "fail", "inconclusive"] },
        "transcript_ref": { "type": "string", "minLength": 1 }
      },
      "required": ["probe_ref", "round_index", "verdict"],
      "additionalProperties": false
    },
    "payload_redteam.strategy.adjusted": {
      "type": "object",
      "properties": {
        "based_on_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "previous_vector": { "type": "string" },
        "next_vector": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1, "description": "Agentic decision rationale for the pivot." }
      },
      "required": ["next_vector", "reason"],
      "additionalProperties": false
    },
    "payload_redteam.finding.logged": {
      "type": "object",
      "properties": {
        "finding_id": { "type": "string", "minLength": 1 },
        "category": {
          "type": "object",
          "properties": {
            "owasp": { "type": "string" },
            "atlas": { "type": "string" },
            "nist": { "type": "string" }
          },
          "additionalProperties": false
        },
        "affected_component": { "type": "string", "minLength": 1 },
        "reproducible_case_ref": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "remediation_hint": { "type": "string" }
      },
      "required": ["finding_id", "category", "affected_component", "reproducible_case_ref", "severity"],
      "additionalProperties": false
    },
    "payload_redteam.metric.updated": {
      "type": "object",
      "properties": {
        "metric_name": { "type": "string", "enum": ["asr", "queries_per_attack", "harm_category_heatmap", "other"] },
        "value": {},
        "scope": { "type": "string" }
      },
      "required": ["metric_name", "value"],
      "additionalProperties": false
    },
    "payload_redteam.report.ready": {
      "type": "object",
      "properties": {
        "report_id": { "type": "string", "minLength": 1 },
        "finding_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "summary": { "type": "string" }
      },
      "required": ["report_id", "finding_refs"],
      "additionalProperties": false
    },
    "payload_redteam.remediation.retested": {
      "type": "object",
      "properties": {
        "finding_ref": { "type": "string", "minLength": 1 },
        "patch_ref": { "type": "string" },
        "retest_result": { "type": "string", "enum": ["pass", "fail"] },
        "notes": { "type": "string" }
      },
      "required": ["finding_ref", "retest_result"],
      "additionalProperties": false
    },

    "event": {
      "type": "object",
      "properties": {
        "schema_version": { "$ref": "#/$defs/schema_version" },
        "id": { "$ref": "#/$defs/id" },
        "event": {
          "anyOf": [{ "$ref": "#/$defs/ingest_event_name" }, { "$ref": "#/$defs/redteam_event_name" }]
        },
        "ts": { "$ref": "#/$defs/timestamp" },
        "agent": { "$ref": "#/$defs/agent" },
        "run_id": { "$ref": "#/$defs/run_id" },
        "payload": {
          "type": "object",
          "description": "Event-specific payload. For redteam.* events, further constrained by the payload_<event> definitions in this schema. For ingest.* events, currently open (agent0's event catalog is drafted in Phase 3)."
        }
      },
      "required": ["schema_version", "id", "event", "ts", "agent", "run_id", "payload"],
      "allOf": [
        { "if": { "properties": { "event": { "const": "redteam.target.registered" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/payload_redteam.target.registered" } } } },
        { "if": { "properties": { "event": { "const": "redteam.intel.ingested" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/payload_redteam.intel.ingested" } } } },
        { "if": { "properties": { "event": { "const": "redteam.probe.built" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/payload_redteam.probe.built" } } } },
        { "if": { "properties": { "event": { "const": "redteam.attack.round.completed" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/payload_redteam.attack.round.completed" } } } },
        { "if": { "properties": { "event": { "const": "redteam.strategy.adjusted" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/payload_redteam.strategy.adjusted" } } } },
        { "if": { "properties": { "event": { "const": "redteam.finding.logged" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/payload_redteam.finding.logged" } } } },
        { "if": { "properties": { "event": { "const": "redteam.metric.updated" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/payload_redteam.metric.updated" } } } },
        { "if": { "properties": { "event": { "const": "redteam.report.ready" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/payload_redteam.report.ready" } } } },
        { "if": { "properties": { "event": { "const": "redteam.remediation.retested" } } }, "then": { "properties": { "payload": { "$ref": "#/$defs/payload_redteam.remediation.retested" } } } }
      ]
    }
  },
  "$ref": "#/$defs/event"
}
